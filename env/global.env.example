# --- Path Configuration ---
# Base paths (Option A: appdata on microSD)
APPDATA_ROOT=/home/wimbox/.local/share/wimbox/appdata
# Future (when HDD is mounted) you can add:
MEDIA_ROOT=/srv/media

# --- Network Configuration ---
# The base domain for all services (e.g., example.com)
BASE_DOMAIN=example.com

# --- Cloudflare Tunnel ---
# Token for cloudflared container
TUNNEL_TOKEN=

# --- Diun (Docker Image Update Notifier) ---
DIUN_NOTIF_NTFY_ENDPOINT=https://ntfy.example.com
DIUN_NOTIF_NTFY_TOPIC=docker_updates
DIUN_NOTIF_NTFY_TOKEN=

# --- Timezone ---
TZ=Europe/Warsaw

# --- Immich ---
IMMICH_DB_USERNAME=immich
IMMICH_DB_PASSWORD=change-me
IMMICH_DB_DATABASE_NAME=immich

# --- Chibisafe ---
CHIBISAFE_ADMIN_PASSWORD=change-me

# --- Dufs (WebDAV) ---
# Format: username:password@/path:rw
# Multiple users: user1:pass1@/:rw|user2:pass2@/:r
DUFS_AUTH=admin:change-me@/:rw

# --- KOSync (KOReader sync server) ---
# Set to false after creating your account to lock down registration
KOSYNC_ENABLE_USER_REGISTRATION=true

# --- Miniflux ---
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=change-me
MINIFLUX_DB_PASSWORD=change-me

# --- Karakeep ---
# echo "KARAKEEP_NEXTAUTH_SECRET=$(openssl rand -base64 36)" >> global.env
# echo "KARAKEEP_MEILI_MASTER_KEY=$(openssl rand -base64 36)" >> global.env
KARAKEEP_NEXTAUTH_SECRET=change-me
KARAKEEP_MEILI_MASTER_KEY=change-me

# --- n8n ---
# echo "N8N_ENCRYPTION_KEY=$(openssl rand -base64 36)" >> global.env
N8N_ENCRYPTION_KEY=change-me

# --- OmniRoute ---
# echo "OMNIROUTE_JWT_SECRET=$(openssl rand -base64 48)" >> global.env
# echo "OMNIROUTE_API_KEY_SECRET=$(openssl rand -hex 32)" >> global.env
# echo "OMNIROUTE_WS_BRIDGE_SECRET=$(openssl rand -base64 32)" >> global.env
OMNIROUTE_JWT_SECRET=change-me
OMNIROUTE_API_KEY_SECRET=change-me
OMNIROUTE_WS_BRIDGE_SECRET=change-me
# Initial admin dashboard password - change after first login via Settings > Security
OMNIROUTE_INITIAL_PASSWORD=change-me

# --- BookOrbit ---
# echo "BOOKORBIT_DB_PASSWORD=$(openssl rand -hex 24)" >> global.env
# echo "BOOKORBIT_JWT_SECRET=$(openssl rand -hex 32)" >> global.env
# echo "BOOKORBIT_SETUP_TOKEN=$(openssl rand -hex 16)" >> global.env
BOOKORBIT_DB_PASSWORD=change-me
BOOKORBIT_JWT_SECRET=change-me
BOOKORBIT_SETUP_TOKEN=change-me
# New in 3.0.0. A fresh install generates its own:
# echo "BOOKORBIT_PODCAST_ENCRYPTION_KEY=$(openssl rand -hex 32)" >> global.env
# An install upgrading from 2.x must instead copy BOOKORBIT_JWT_SECRET here, or
# podcast URLs issued before the upgrade can no longer be decrypted.
BOOKORBIT_PODCAST_ENCRYPTION_KEY=change-me
